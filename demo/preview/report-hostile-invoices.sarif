{"$schema":"https://json.schemastore.org/sarif-2.1.0.json","version":"2.1.0","runs":[{"tool":{"driver":{"name":"ProofBox","informationUri":"https://github.com/","rules":[{"id":"F1","name":"split_bill silently loses cents","shortDescription":{"text":"split_bill silently loses cents"},"fullDescription":{"text":"split_bill floors every share and drops the remainder, so a 10.00 bill split three ways only collects 9.99."},"properties":{"security-severity":"8.0"}},{"id":"F3","name":"Path traversal in load_template","shortDescription":{"text":"Path traversal in load_template"},"fullDescription":{"text":"load_template joins an untrusted name onto the template folder, so ?template=../../etc/passwd reads any file the server can read."},"properties":{"security-severity":"9.5"}}]}},"results":[{"ruleId":"F1","level":"error","message":{"text":"split_bill floors every share and drops the remainder, so a 10.00 bill split three ways only collects 9.99. Proven in sandbox by proofbox_tests/test_split.py (exit 0)."},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"invoice_tools/money.py"},"region":{"startLine":15}}}],"properties":{"proven":true,"proof_command":"python -m pytest -q -s -p no:cacheprovider --noconftest proofbox_tests/test_split.py","fix_verified":true,"fix_diff":"--- a/invoice_tools/money.py\n+++ b/invoice_tools/money.py\n@@ -12,5 +12,5 @@\n     \"\"\"Split a bill between people. The shares must add up to the total.\"\"\"\n     if people <= 0:\n         raise ValueError(\"people must be positive\")\n-    share = total_cents // people\n-    return [share] * people\n+    share, rest = divmod(total_cents, people)\n+    return [share + 1] * rest + [share] * (people - rest)\n"}},{"ruleId":"F3","level":"error","message":{"text":"load_template joins an untrusted name onto the template folder, so ?template=../../etc/passwd reads any file the server can read. Proven in sandbox by proofbox_tests/test_traversal.py (exit 0)."},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"invoice_tools/templates.py"},"region":{"startLine":10}}}],"properties":{"proven":true,"proof_command":"python -m pytest -q -s -p no:cacheprovider --noconftest proofbox_tests/test_traversal.py","fix_verified":true,"fix_diff":"--- a/invoice_tools/templates.py\n+++ b/invoice_tools/templates.py\n@@ -7,6 +7,8 @@\n \n def load_template(name: str) -> str:\n     # Names come straight from the HTTP query string, e.g. ?template=modern.txt\n-    path = os.path.join(TEMPLATE_DIR, name)\n+    path = os.path.realpath(os.path.join(TEMPLATE_DIR, name))\n+    if os.path.dirname(path) != os.path.realpath(TEMPLATE_DIR):\n+        raise ValueError(\"template name escapes the template folder\")\n     with open(path, encoding=\"utf-8\") as fh:\n         return fh.read()\n"}}],"properties":{"audit_head":"99e11ed52a1886770f2c0de00e5549dbe29d39fca92e1e98e2265f6607445540","audit_valid":true,"signature":"fd104e4e12f718af721c6e8dc8f2cb40f220148707815241b66db3b5e68ca7b6"}}]}