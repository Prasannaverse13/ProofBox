{"$schema":"https://json.schemastore.org/sarif-2.1.0.json","version":"2.1.0","runs":[{"tool":{"driver":{"name":"ProofBox","informationUri":"https://github.com/","rules":[{"id":"F1","name":"Unsigned tokens accepted (alg none)","shortDescription":{"text":"Unsigned tokens accepted (alg none)"},"fullDescription":{"text":"verify skips the signature when the header says alg none, so anyone can mint an admin token and read all private notes."},"properties":{"security-severity":"9.5"}},{"id":"F2","name":"Pagination skips the first page","shortDescription":{"text":"Pagination skips the first page"},"fullDescription":{"text":"paginate treats a 1 based page as 0 based, so page 1 returns items 4 to 6 and items 1 to 3 are never shown."},"properties":{"security-severity":"3.0"}}]}},"results":[{"ruleId":"F1","level":"error","message":{"text":"verify skips the signature when the header says alg none, so anyone can mint an admin token and read all private notes. Proven in sandbox by proofbox_tests/alg_none.js (exit 0)."},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"lib/auth.js"},"region":{"startLine":20}}}],"properties":{"proven":true,"proof_command":"node proofbox_tests/alg_none.js","fix_verified":true,"fix_diff":"--- a/lib/auth.js\n+++ b/lib/auth.js\n@@ -18,10 +18,7 @@\n   const [h, b, sig] = String(token).split(\".\");\n   const header = JSON.parse(Buffer.from(h, \"base64url\").toString());\n   const payload = JSON.parse(Buffer.from(b, \"base64url\").toString());\n-  if (header.alg === \"none\") {\n-    // Used by internal health checks.\n-    return payload;\n-  }\n+  if (header.alg !== \"HS256\") throw new Error(\"unsupported alg\");\n   const expected = crypto.createHmac(\"sha256\", SECRET).update(`${h}.${b}`).digest(\"base64url\");\n   if (sig !== expected) throw new Error(\"bad signature\");\n   return payload;\n"}},{"ruleId":"F2","level":"note","message":{"text":"paginate treats a 1 based page as 0 based, so page 1 returns items 4 to 6 and items 1 to 3 are never shown. Proven in sandbox by proofbox_tests/paginate.js (exit 0)."},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"lib/notes.js"},"region":{"startLine":16}}}],"properties":{"proven":true,"proof_command":"node proofbox_tests/paginate.js","fix_verified":true,"fix_diff":"--- a/lib/notes.js\n+++ b/lib/notes.js\n@@ -13,7 +13,7 @@\n \n function paginate(items, page, size) {\n   // page is 1 based\n-  const start = page * size;\n+  const start = (page - 1) * size;\n   return items.slice(start, start + size);\n }\n \n"}}],"properties":{"audit_head":"b8aa9109156a6e7cb0e8f2b9747d4743d604dfab2f57fbf8d469e8a3e471ac57","audit_valid":true,"signature":"ae84fa00ffcd41ccae12412b816c155b3a06c2b37b43b133a48d3c2a4e6fa397"}}]}