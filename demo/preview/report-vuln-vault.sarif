{"$schema":"https://json.schemastore.org/sarif-2.1.0.json","version":"2.1.0","runs":[{"tool":{"driver":{"name":"ProofBox","informationUri":"https://github.com/","rules":[{"id":"F1","name":"Reentrancy drains the vault","shortDescription":{"text":"Reentrancy drains the vault"},"fullDescription":{"text":"withdraw makes the external call before setting the balance to zero, so an attacker contract re enters and takes every depositor's ETH."},"properties":{"security-severity":"9.5"}},{"id":"F2","name":"Anyone can take ownership and freeze funds","shortDescription":{"text":"Anyone can take ownership and freeze funds"},"fullDescription":{"text":"setOwner has no onlyOwner check, so any address can make itself owner and pause withdrawals for every user."},"properties":{"security-severity":"8.0"}}]}},"results":[{"ruleId":"F1","level":"error","message":{"text":"withdraw makes the external call before setting the balance to zero, so an attacker contract re enters and takes every depositor's ETH. Proven in sandbox by test/ProofReentrancy.t.sol (exit 0)."},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"src/EtherVault.sol"},"region":{"startLine":30}}}],"properties":{"proven":true,"proof_command":"forge test --offline --match-path test/ProofReentrancy.t.sol -vv","fix_verified":true,"fix_diff":"--- a/src/EtherVault.sol\n+++ b/src/EtherVault.sol\n@@ -26,10 +26,10 @@\n         uint256 amount = balances[msg.sender];\n         require(amount > 0, \"nothing to withdraw\");\n \n+        balances[msg.sender] = 0;\n+\n         (bool ok, ) = msg.sender.call{value: amount}(\"\");\n         require(ok, \"transfer failed\");\n-\n-        balances[msg.sender] = 0;\n         emit Withdraw(msg.sender, amount);\n     }\n \n"}},{"ruleId":"F2","level":"error","message":{"text":"setOwner has no onlyOwner check, so any address can make itself owner and pause withdrawals for every user. Proven in sandbox by test/ProofOwner.t.sol (exit 0)."},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"src/EtherVault.sol"},"region":{"startLine":37}}}],"properties":{"proven":true,"proof_command":"forge test --offline --match-path test/ProofOwner.t.sol -vv","fix_verified":true,"fix_diff":"--- a/src/EtherVault.sol\n+++ b/src/EtherVault.sol\n@@ -34,6 +34,7 @@\n     }\n \n     function setOwner(address newOwner) external {\n+        require(msg.sender == owner, \"not owner\");\n         owner = newOwner;\n     }\n \n"}}],"properties":{"audit_head":"eaa0f9cdae66f947d6f289fd5f936be6010257aac15784f8b0b719fb23d349bc","audit_valid":true,"signature":"a37aa5809f7b850cbd36f632a753214727e32f2c7240f63a21dfcd9485b3314f"}}]}