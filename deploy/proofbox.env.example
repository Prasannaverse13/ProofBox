# Copy to /etc/proofbox.env on the VM. chmod 600. Never inside the sandbox.
# Without a key the agent runs in demo mode (scripted agent, real sandbox).
VULTR_INFERENCE_API_KEY=
VULTR_INFERENCE_BASE_URL=https://api.vultrinference.com/v1
# Pick any id from: curl -H "Authorization: Bearer $VULTR_INFERENCE_API_KEY" https://api.vultrinference.com/v1/models
PROOFBOX_MODEL=kimi-k2-instruct

PROOFBOX_SANDBOX_IMAGE=proofbox-sandbox:latest
# Set to runsc after installing gVisor for a user space kernel on top of the container.
PROOFBOX_SANDBOX_RUNTIME=
PROOFBOX_SANDBOX_MEMORY=512m
PROOFBOX_COMMAND_TIMEOUT=30
PROOFBOX_JOB_TIMEOUT=600
PROOFBOX_DATA_DIR=/var/lib/proofbox

# Optional. Key that signs each audit trail. If unset, one is generated in the data folder.
# PROOFBOX_SIGNING_KEY=
